# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/**/.turbo/*
/**/node_modules
/**/.pnp
/**/.pnp.*
/**/.yarn/*
/**/!.yarn/patches
/**/!.yarn/plugins
/**/!.yarn/releases
/**/!.yarn/versions
/**/.playwright-mcp

# testing
/coverage

# next.js
/**/.next/
/**/out/

# production
/**/build
/**/dist

# misc
/**/.DS_Store
/**/*.pem

# debug
/**/npm-debug.log*
/**/yarn-debug.log*
/**/yarn-error.log*
/**/.pnpm-debug.log*

# env files
/**/.env
/**/.env.*
!/**/.env.example

# vercel
/**/.vercel

# typescript
/**/*.tsbuildinfo
/**/next-env.d.ts

# coverage
/**/packages/**/coverage

# >>> harness (managed by `harness sync`) >>>
.agent/dependencies/*
.omp/
# <<< harness <<<

# playwright / lighthouse
/**/test-results
/**/playwright-report
/**/.lighthouseci
/**/e2e/.auth

# Private business files stay here, untracked (.agent/ is public). Never commit them.
/.agent/docs/business/
/.agent/docs/specs/2026-11-12-business-plan/
