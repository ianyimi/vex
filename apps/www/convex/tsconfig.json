{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": [
      "ES2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "~/*": [
        "../src/*"
      ],
      "@convex/*": [
        "./*"
      ]
    },
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "./**/*",
    "../src/vex.types.ts"
  ],
  "exclude": [
    "./_generated"
  ]
}
