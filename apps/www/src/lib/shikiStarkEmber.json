{
  "name": "stark-ember",
  "type": "dark",
  "colors": {
    "editor.background": "#0F0F0F",
    "editor.foreground": "#D4D4D4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#7A7A7A" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "support.type.primitive",
        "variable.language"
      ],
      "settings": { "foreground": "#F2864F" }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.function",
        "meta.definition.variable entity.name.function"
      ],
      "settings": { "foreground": "#F4F4F4" }
    },
    {
      "scope": ["string", "string.quoted", "constant.numeric", "constant.character"],
      "settings": { "foreground": "#ABABAB" }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "keyword.operator"
      ],
      "settings": { "foreground": "#6B6B6B" }
    },
    {
      "scope": ["variable", "variable.other", "meta.object-literal.key", "support.variable"],
      "settings": { "foreground": "#D4D4D4" }
    }
  ]
}
