{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@convex/*": [
        "./convex/*"
      ],
      "@vexcms/core": [
        "../../packages/core/src/index.ts"
      ],
      "@vexcms/react": [
        "../../packages/react/src/index.ts"
      ],
      "@vexcms/next": [
        "../../packages/next/src/index.ts"
      ],
      "@vexcms/next/server": [
        "../../packages/next/src/NextAdminPage.tsx"
      ],
      "@vexcms/next/client": [
        "../../packages/next/src/NextAdminLayout.tsx"
      ],
      "@vexcms/better-auth": [
        "../../packages/better-auth/src/index.ts"
      ],
      "@vexcms/file-storage-convex": [
        "../../packages/file-storage-convex/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
