{
  "name": "@vexcms/next",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "source": "./src/NextAdminPage.tsx",
      "import": "./dist/NextAdminPage.js",
      "types": "./dist/NextAdminPage.d.ts"
    },
    "./client": {
      "source": "./src/NextAdminLayout.tsx",
      "import": "./dist/NextAdminLayout.js",
      "types": "./dist/NextAdminLayout.d.ts"
    },
    "./styles": "./styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@vexcms/core": "workspace:*",
    "@vexcms/react": "workspace:*",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "@convex-dev/react-query": "catalog:",
    "@tanstack/react-form": "^0.40.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "convex": "catalog:",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tanstack/react-form": "^0.40.0",
    "@tanstack/react-table": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vexcms/tsconfig": "workspace:*",
    "next": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
