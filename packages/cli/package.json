{
  "name": "@vexcms/cli",
  "version": "0.1.0-alpha.10",
  "description": "VexCMS CLI: dev server orchestration and type generation",
  "keywords": [
    "cms",
    "headless-cms",
    "convex",
    "typescript",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Isaiah Anyimi",
  "homepage": "https://docs.vexcms.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianyimi/vex.git",
    "directory": "packages/cli"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "vex": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "node --watch-path src watch.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "catalog:",
    "jiti": "catalog:"
  },
  "peerDependencies": {
    "@vexcms/core": "workspace:^",
    "convex": "catalog:peers"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vexcms/core": "workspace:*",
    "@vexcms/tsconfig": "workspace:*",
    "convex": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
