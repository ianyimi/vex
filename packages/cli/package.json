{
  "name": "@vexcms/cli",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "bin": {
    "vex": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "node --watch-path src watch.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "catalog:",
    "jiti": "catalog:"
  },
  "peerDependencies": {
    "@vexcms/core": "workspace:*",
    "convex": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vexcms/core": "workspace:*",
    "@vexcms/tsconfig": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
