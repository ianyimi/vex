{
  "name": "@vexcms/core",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "source": "./src/api/server.ts",
      "types": "./dist/api/server.d.ts",
      "import": "./dist/api/server.js"
    },
    "./client": {
      "source": "./src/api/client.ts",
      "types": "./dist/api/client.d.ts",
      "import": "./dist/api/client.js"
    },
    "./convex": {
      "source": "./src/api/server.ts",
      "types": "./dist/api/server.d.ts",
      "import": "./dist/api/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "node --watch-path src watch.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@convex-dev/react-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "convex": "catalog:",
    "lucide-react": "catalog:",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@convex-dev/react-query": "catalog:",
    "@edge-runtime/vm": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vexcms/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "convex-test": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
