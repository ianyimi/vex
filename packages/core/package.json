{
  "name": "@vexcms/core",
  "version": "0.1.0-alpha.24",
  "description": "Convex-native headless CMS core: field factories, schema generation, and typed collection APIs",
  "keywords": [
    "cms",
    "headless-cms",
    "convex",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Isaiah Anyimi",
  "homepage": "https://docs.vexcms.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianyimi/vex.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "source": "./src/api/server.ts",
      "types": "./dist/api/server.d.ts",
      "import": "./dist/api/server.js"
    },
    "./convex": {
      "source": "./src/api/server.ts",
      "types": "./dist/api/server.d.ts",
      "import": "./dist/api/server.js"
    },
    "./internal": {
      "source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "node --watch-path src watch.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nanoid": "catalog:",
    "pluralize-esm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@types/node": "catalog:",
    "@vexcms/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "convex-test": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "convex": "catalog:peers"
  }
}
