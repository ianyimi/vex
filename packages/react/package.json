{
  "name": "@vexcms/react",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css"
  ],
  "source": "./dist/**/*.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
