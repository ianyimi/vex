    "@tanstack/react-form": "^0.40.0",
    "@tanstack/react-table": "catalog:",
    "@uiw/react-color-sketch": "^2.9.6",
    "@vexcms/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "catalog:",
    "react-day-picker": "^9.6.0",
    "tailwind-merge": "3.5.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@tanstack/react-query": ">=5.0.0",
    "convex": ">=1.0.0",
    "next": ">=14.0.0",
    "nuqs": "catalog:",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "^25.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vexcms/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
