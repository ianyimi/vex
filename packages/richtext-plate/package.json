{
  "name": "@vexcms/richtext-plate",
  "version": "0.1.0-alpha.12",
  "description": "Plate rich-text editor integration for VexCMS",
  "keywords": [
    "cms",
    "headless-cms",
    "convex",
    "typescript",
    "richtext",
    "plate"
  ],
  "license": "Apache-2.0",
  "author": "Isaiah Anyimi",
  "homepage": "https://docs.vexcms.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianyimi/vex.git",
    "directory": "packages/richtext-plate"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@platejs/basic-nodes": "catalog:",
    "@platejs/code-block": "catalog:",
    "@platejs/link": "catalog:",
    "@platejs/list": "catalog:",
    "@platejs/media": "catalog:",
    "@platejs/table": "catalog:",
    "@vexcms/core": "workspace:*",
    "platejs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vexcms/tsconfig": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  }
}
